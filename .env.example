# Copy this file to .env and fill in only the services you use.
# Never commit .env or real token values (.env đã .gitignore).
# Phần phát hiện đạo văn (retrieval + alignment) KHÔNG cần key; chỉ các vai trò LLM
# (demo: Luận giải/Phân loại/Xác minh/Viết lại; và script eval gọi LLM) mới cần.

# --- Provider cho vai trò LLM: fpt | gemini ---
LLM_PROVIDER=fpt

# --- FPT AI Marketplace (OpenAI-compatible) — GLM-5.2 cho demo (khuyến nghị) ---
LLM_API_KEY=
LLM_API_BASE=https://mkp-api.fptcloud.com
LLM_MODEL=GLM-5.2

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_JUDGE_MODEL=gemini-flash-latest

# --- NVIDIA (rewrite provider tùy chọn) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional additional project keys; reference their variable names with
# `api_key_env` in generation/experiments/nvidia_free.yaml.
# NVIDIA_API_KEY_PROJECT_A=
REWRITE_PROVIDER=gemini
NVIDIA_MODEL=

KAGGLE_API_TOKEN=

# Optional for public Hugging Face models.
HF_TOKEN=

PYTHONUTF8=1
