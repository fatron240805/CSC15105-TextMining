# Copy this file to .env and fill in only the services you use.
# Never commit .env or real token values.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_JUDGE_MODEL=gemini-flash-latest

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional additional project keys; reference their variable names with
# `api_key_env` in generation/experiments/nvidia_free.yaml.
# NVIDIA_API_KEY_PROJECT_A=
REWRITE_PROVIDER=gemini
NVIDIA_MODEL=

KAGGLE_API_TOKEN=

# Optional for public Hugging Face models.
HF_TOKEN=

PYTHONUTF8=1
