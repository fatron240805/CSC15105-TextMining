docs/

# Data — PAN 2025 dataset is too large for git (~2.4 GB).
# Keep only the raw-data README; ignore all actual documents/labels.
data/**
!data/
!data/raw/
!data/raw/README.md

# Generated outputs (label dumps, EDA/eval CSVs — regenerable from scripts)
outputs/

# Kaggle staged data — assembled by scripts/kaggle_stage.py (labels ~480MB, corpus ~2.4GB).
# Track only the dataset-metadata.json; ignore the staged .csv/.txt payload.
kaggle_datasets/**
!kaggle_datasets/
!kaggle_datasets/**/
!kaggle_datasets/**/dataset-metadata.json

